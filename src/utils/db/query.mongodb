use("facturacionCampus_EmilyNieves");

db.createCollection("counters");
db.counters.insertMany([
  {
    _id: "facturaVentaId",
    seq: 0,
  },
  {
    _id: "comprasId",
    seq: 0,
  },
  {
    _id: "proveedoresId",
    seq: 0,
  },
  {
    _id: "empleadosId",
    seq: 0,
  },
  {
    _id: "medicosId",
    seq: 0,
  },
  {
    _id: "pacientesId",
    seq: 0,
  },
  {
    _id: "inventariosId",
    seq: 0,
  },
  {
    _id: "medicamentosId",
    seq: 0,
  },
  {
    _id: "recetasId",
    seq: 0,
  },
]);
function getNextid(col) {
  let ret = db.counters.findAndModify({
    query: { _id: col + "Id" },
    update: { $inc: { seq: 1 } },
    new: true,
  });
  console.log(ret.seq);
  return ret.seq;
}

db.createCollection("pacientes", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: [
        "idPaciente",
        "documento",
        "nombreCompleto",
        "fechaNacimiento",
        "direccion",
        "telefono",
      ],
      properties: {
        idPaciente: {
          bsonType: "int",
          description: "Id del paciente",
        },
        documento: {
          bsonType: "number",
          description: "Documento de identidad de un paciente",
        },
        nombreCompleto: {
          bsonType: "string",
          description: "Nombre completo del paciente",
        },
        fechaNacimiento: {
          bsonType: "date",
          description: "Fecha de nacimiento del paciente",
        },
        direccion: {
          bsonType: "string",
          description: "Dirección del paciente",
        },
        telefono: {
          bsonType: "number",
          description: "Telefono de contacto del paciente",
        },
      },
    },
  },
});

